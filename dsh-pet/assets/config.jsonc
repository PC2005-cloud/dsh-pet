// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config.jsonc 拉取；字段缺失/写错会取内置默认值并告警
//       （结构性缺失静默、显式写错告警），返回给消费端的永远是填满的成品。
// 字段归属（三层，改配置前先看这里）：
//   · 实例级（写在 pets[] 里，每只独立）：name / id / size / balanceEnabled / whisperEnabled /
//     workStatusEnabled / fixedEnabled / display / position
//   · 全局默认（本文件是默认值；用户在 main-config.jsonc 里写一次就对**所有宠物**生效，
//     含 pet/<名>-config.json 定义的种类；种类文件自己写了则覆盖自己那份）：
//     physics / confineToScreen / whisperImageEnabled / chatImageEnabled /
//     chatMemoryRounds / whisperModel / chatModel / eventsRefreshSec
//   · 条目级（每个条目一份：main 一份、每个种类各一份；种类文件顶层可覆盖）：
//     whisperPrompt / memes / workStatusTexts / animations / animationWeights
//   · 只读 main（写了也只认 main 条目那份）：notificationsEnabled / eventsRefreshSec.balance
// 合并口径：所有顶层字段都是**整段替换**——写了就整段用自己的，缺的子键不会从本文件补回来
//   （消费端各自兜底：余额周期读不到按 1800、碎碎念按 300）。
{
  // ===================== 碎碎念（系统提示词人设，条目级——每个种类一份；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 宠物开启碎碎念（pets[].whisperEnabled = true）时，按 eventsRefreshSec.whisper 周期
  // 用此提示词调用当前服务商生成一句话，气泡显示。说人话、不啰嗦、不解释自己、不提 AI。
  "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 5，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 5。
  // 设置页「AI 模型与对话上下文」区有数字输入框，改这里或那里等价（设置页写的是用户层）。
  "chatMemoryRounds": 5,
  // ===================== 碎碎念模型（全局默认：用户层写了对所有宠物生效；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 碎碎念用哪个服务商 + 模型生成。provider 与 model **都留空 = 跟随当前对话的模型**（默认，与旧行为一致）；
  // 想给后台自动跑的碎碎念单独用便宜/快的模型就填上（设置页有下拉框，选项与 DSH 的模型选择器同源）。
  // 只填一半（选了服务商没选模型，或反之）即配置错误 → 告警并取默认（跟随当前对话）。
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（全局默认；同上，留空 = 跟随当前对话） =====================
  // 右键菜单「对话」与桌宠聊天时用哪个服务商 + 模型。填了但调用失败（凭据被删 / 模型下架 /
  // 该服务商没配 key）会**自动回落到当前对话的模型重试一次**，仍失败才按生成失败报错。
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，碎碎念每次生成时从 memes 图片池随机抽 1 张，连同那句话一起显示（气泡配图）。
  // 碎碎念本身是"随口一句"，没有上下文可选，所以按随机抽（与对话的 AI 选图策略不同）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "whisperImageEnabled": true,
  // ===================== 表情包：对话配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，对话生成时把全部表情包（名称 + 描述）交给模型，由它按当前语境选 1 张；
  // 模型不选或选了不存在的图则不配图（对话配图是可选点缀，不强制每句都带）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "chatImageEnabled": true,
  // ===================== 表情包：对话配图张数上限（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 对话时发给模型的表情包清单**最多几张**（「前 N 张」= 配置里**写在前面的那 N 条**——
  // 想让哪几张优先被发出去，把它们的顺序往前挪即可；本文件里的书写顺序就是生效顺序）。
  // 为什么要它：这张清单是**每条消息都要附**的，token 随图片数量线性增长（本文件 27 张约 1.1k 字符 ≈ 650 token），
  // 张数一多就是纯烧钱——限制成前 N 张，模型只从这几张里挑，费用上限立刻可控。
  // 非负整数；**内置默认 10**（27 张的池子砍到约 1/3 开销，可选项仍够挑）；0 = 不限制（全部发）。
  // 只影响对话选图：碎碎念只带抽中的那一张，与本项无关。
  "chatImageLimit": 10,
  // ===================== 表情包：图片映射（名称 → 描述，模型据此选图） =====================
  // 键 = assets/memes/<键>.png 的文件名（不含扩展名）；值 = 该图内容的简要描述。
  // 用途：碎碎念随机抽到某张图后，把该图描述注入提示词让模型配合画面说话；
  //       对话则把整张表交给模型，由它挑一张最贴切当前语境的。
  // 要求：键必须与 assets/memes 下的 png 文件名一一对应（文件缺失即该条失效并告警）；
  //       值为非空字符串。想停用某张图就从对象里删掉该键，不用改图片文件。
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页保存宠物时会保留该字段。
  "notificationsEnabled": true,
  // ===================== 拖拽抛掷：锁定在当前屏幕（根字段，不属于 physics） =====================
  // 多屏用户：true = 甩出去的宠物只在松手时所在那块屏幕内弹（屏缝当墙，不飞到隔壁屏）；
  // false（默认）= 屏缝两侧都有屏时照常跨屏飞行、落到隔壁屏（现状）。
  // 放根字段而不塞进 physics：它不改手感参数（重力/恢复系数/力度那些），只改「宠物被允许去哪」。
  // 必填布尔值，缺失即配置错误；也可在用户配置（main-config.jsonc）顶层覆盖，设置页开关写的就是它。
  // 全局默认：用户层写一次对**所有宠物**生效（含种类）；种类文件 pet/<名>-config.json 顶层写了则用自己那份。
  // 仅影响桌面模式（浏览器 overlay 本来就只在视口内弹）。改动后刷新或重启生效。
  "confineToScreen": false,
  // ===================== 工作状态联动文案（条目级，与 animations/physics 同级；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句（想固定单句就只写一个；想换文案只改这里）。
  // 省略整个字段 = 不弹工作状态气泡文本（仍播动画）；省略某档 = 该档不显示文本。
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 关闭（默认，宠物互相穿过）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
  // 每个宠物独立：name（显示名，可重复：悬浮提示 / AI 人设追加「你的名字是X」/ 未来命令行定位的
  //   显示层。可省略——缺失或留空按该宠物 id 处理并告警，兼容旧配置）、
  // id（唯一标识，程序定位用：素材/记忆/端点参数都按它，绝不重叠，冲突即配置错误）、
  // size（宽度 px，高度自动 = size × 9/16）、
  // balanceEnabled（是否启用余额功能：true=触发余额动画+显示余额气泡；false=该宠物完全禁用。
  //   必填布尔值，缺失即配置错误）、display（显示位置，必填四值之一：
  //   web=仅浏览器 overlay / desktop=仅桌面模式（Electron 透明窗）/ both=两者/ none=都不显示。
  //   缺失按默认 both 处理并告警（兼容 ≤0.2.0 旧配置），写了非法值即配置错误；桌面模式渲染
  //   display 含 desktop/both 的全部宠物，每只一个局部小窗）、
  // position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）
  "pets": [
    {
      "name": "蓝毛小女仆",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      // 碎碎念默认开启：每次生成都会调用当前对话的模型。本地 LLM 单并发时，
      // 后台碎碎念会顶掉正在跑的任务的 KV cache（与 DSH 多子代理同因）。
      // 不需要碎碎念的宠物改为 false（设置页也可开关）。
      "whisperEnabled": true,
      // 工作状态联动默认开启：监听 DSH 会话事件（工具调用等），按
      // animations.events.workStatus 数组切档位动画 + 气泡（仅监听，不调用模型）。
      "workStatusEnabled": true,
      // 宠物固定：true = 随机动画链不再抽「转向 / 移动」两档——宠物不自己翻朝向、也不自己
      // 走开，只播原地待机与随机小动作（两档原本的权重自然并入随机小动作，见文件末尾
      // animationWeights 的说明）。默认 false = 保持原行为（会自己走、会自己翻）。
      // **只影响随机链**：右键菜单点播（含「转向 / 移动」两项）、/anim 接口与命令、
      // 余额/碎碎念/工作状态事件动画、点击回应与拖拽一律照常——用户主动触发的不受此限制。
      // 设置页有同名勾选框。改动后刷新或重启生效。
      "fixedEnabled": false,
      "display": "both",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  // 动画素材目录（用户自定义 / 覆盖包内素材）：
  //   $DSH_HOME/dsh-pet/main-animation/webm/（如 C:\Users\<你>\.dsh\dsh-pet\main-animation\webm\）
  //   —— 唯一格式 .webm，文件名必须与下面各池写定的动画名一致（不含扩展名，中文/空格都行）。
  //   注意：素材要放在 main-animation\webm\ 子目录里，直接放 main-animation\ 下会查不到文件。
  //   （症状：右键菜单照常显示名字——菜单来自本配置——但点击不播放，资源 404。）
  //   素材归属：存在 pet/<素材根>-animation/ 的文件宠物只查自己的目录（绝不回落）；
  //   主配置宠物（main 等）按 main-animation\webm 优先 → 包内 assets/webm 依次查找。
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）
    "idle": ["待机呼吸休闲"],
    // 转向动画池（数组；每一项都必须是“播完会翻转朝向”的动画，如东张西望）
    "turn": ["东张西望"],
    // 拖拽动画池（数组；每一项都必须是“被无形抓起悬空”的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个）
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // 移动动画池：default 是每个动作都用的默认参数；actions 里每项可覆盖部分参数，
    // 未写的字段取 default。minDist/maxDist=单次行进距离(px)——以「基准宠物宽 462px」为准，
    //   运行时按 实际size/462 等比缩放（小宠物挪小步、大宠物挪大步，与人物大小匹配）；
    // margin=贴边安全距(px，不随缩放)、leadSec/tailSec=动画首尾各多少秒原地不动。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示“带文字、镜像会颠倒，
    // 宠物面向右（被镜像）时不播放该类”。所有分类 weight 合计应与 animationWeights 里
    // 顶层权重和的余量（100 − idle − turn − move）相等。
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
        "轻快记录", "写代码", "摇扇纳凉", "晨间刷牙"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ],
    // 事件动画：不进随机链（rollKind/pickNext 不会抽到），只由代码显式触发。
    // events.<事件名> 为档位数组，按「事件档位」顺序排列（索引即档位）。
    // 每个档位的值可以是：单个动画名（固定播，原行为）或候选数组（触发时档内随机抽 1，
    // 尽量不连续重复——同一档位多候选时不会连抽同一个）。空字符串/空数组非法。
    // balance（余额展示，按已用百分比分档，数组顺序 = 档位顺序）：
    //   index = p === 100 ? 5 : Math.floor(p / 20)
    //   即 index 0..4 覆盖 [0,20) [20,40) [40,60) [60,80) [80,100)，index 5 只在 p 恰为 100（全部用完）时播。
    //   与提示词文件 prompts/桌面宠物 10 秒动作提示词.md 的 6 段动画一一对应。
    "events": {
      "balance": [
        "余额-钱袋满溢",   // 0 ≤ p < 20（几乎未消耗）
        "余额-金袋叮当",   // 20 ≤ p < 40
        "余额-钱袋如常",   // 40 ≤ p < 60
        "余额-数金皱眉",   // 60 ≤ p < 80
        "余额-袋空如洗",   // 80 ≤ p < 100（告急）
        "余额-分文不剩"    // p === 100（全部用完，格外档）
      ],
      // 碎碎念：到点随机抽 1 段播（等概率），与 eventsRefreshSec.whisper 周期对应
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      // 工作状态联动（pets[].workStatusEnabled 开启时）：按索引 = 状态档位，勿在中间插入新档
      //（新档只可追加到末尾，否则已生效配置的档位含义错位）：
      //   index 0 = thinking（turn/start 回合开）
      //   index 1 = working（tool/call 工具调用）
      //   index 2 = result（tool/result 工具完成回整理）
      //   index 3 = waiting（approval/asked 等待批准）
      //   index 4 = success（turn/end completed 完成）
      //   index 5 = error（turn/end error/max-tokens 出错/达上限）
      "workStatus": [
        "工作状态-思考冒泡",      // index 0 thinking（turn/start 回合开）
        "工作状态-忙碌点按",      // index 1 working（tool/call 工具调用）
        "工作状态-清点归档",      // index 2 result（tool/result 工具完成回整理）
        "工作状态-原地踱步张望",  // index 3 waiting（approval/asked 等待批准）
        "工作状态-雀跃庆祝",      // index 4 success（turn/end completed 完成）
        "工作状态-垂头叹气冒汗"   // index 5 error（turn/end error/max-tokens 出错/达上限）
      ]
    }
  },

  // ===================== 事件触发周期（全局默认：用户层写一次对所有宠物生效，种类文件顶层可覆盖） =====================
  // 事件名 → 刷新间隔（秒）。**整段替换**：写了就整段用自己的，缺的键不会从内置默认补回来。
  //   · whisper：碎碎念周期，按宠物所属条目读（种类可覆盖）；读不到按 300 兜底。
  //   · balance：余额数据刷新 + 余额动画触发的间隔，**消费端只读 main 条目**（余额数据一份、
  //     host 只有一个定时器，给不了每个种类一个周期）；读不到按 1800 兜底。启动时立即触发一次。
  // 非法数值（非正数/非数字）即整段配置错误 → 告警并回退内置默认。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 5 + 5 + (20+20+16+14+10=80) = 100
  // 注：宠物开了 pets[].fixedEnabled（宠物固定）时，turn/move 两档权重按 0 算（抽不到），
  //     它们的份额自然落到「随机小动作」——即 idle 10 + 小动作 90，不必在这里另算。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
